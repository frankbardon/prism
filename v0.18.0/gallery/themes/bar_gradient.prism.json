{
  "$schema": "urn:prism:schema:v1:spec",
  "title": "Quarterly revenue — linear gradient fill",
  "data": {
    "values": [
      {"quarter": "Q1", "revenue": 120},
      {"quarter": "Q2", "revenue": 145},
      {"quarter": "Q3", "revenue": 138},
      {"quarter": "Q4", "revenue": 172}
    ]
  },
  "mark": "bar",
  "encoding": {
    "x": {"field": "quarter", "type": "nominal"},
    "y": {"field": "revenue", "type": "quantitative"}
  },
  "theme": {
    "name": "light",
    "gradients": {
      "brand_fade": {
        "type": "linear",
        "angle": 90,
        "stops": [
          {"offset": 0, "color": "#4c78a8"},
          {"offset": 1, "color": "#f58518"}
        ]
      }
    },
    "marks": {
      "bar": {"fill": "url(#brand_fade)"}
    }
  }
}
