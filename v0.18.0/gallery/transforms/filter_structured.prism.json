{
  "$schema": "urn:prism:schema:v1:spec",
  "title": "Structured filter (between + one_of)",
  "data": {
    "name": "regions",
    "values": [
      {"region": "NA",    "score": 0.42},
      {"region": "EU",    "score": 0.71},
      {"region": "APAC",  "score": 0.58},
      {"region": "LATAM", "score": 0.49},
      {"region": "MEA",   "score": 0.34},
      {"region": "ANZ",   "score": 0.66}
    ]
  },
  "transform": [
    {"filter": {"and": [
      {"op": "between", "field": "score", "lo": 0.40, "hi": 0.70},
      {"op": "one_of", "field": "region", "values": ["NA", "APAC", "LATAM", "ANZ"]}
    ]}}
  ],
  "mark": {"type": "bar", "corner_radius": 4},
  "encoding": {
    "x": {"field": "region", "type": "nominal"},
    "y": {"field": "score",  "type": "quantitative"},
    "color": {"field": "region", "type": "nominal"}
  }
}
