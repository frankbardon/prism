{
  "$schema": "urn:prism:schema:v1:spec",
  "title": "Brand score (bar with drop-shadow filter)",
  "data": {
    "name": "brand_scores",
    "values": [
      {"brand_id": "alpha", "score": 0.42},
      {"brand_id": "beta",  "score": 0.71},
      {"brand_id": "gamma", "score": 0.58}
    ]
  },
  "mark": "bar",
  "encoding": {
    "x": {"field": "brand_id", "type": "nominal"},
    "y": {"field": "score",    "type": "quantitative"}
  },
  "theme": {
    "name": "light",
    "mark": {"filter": "drop-shadow"},
    "filters": {
      "drop-shadow": "<feDropShadow dx=\"1\" dy=\"2\" stdDeviation=\"2\" flood-opacity=\"0.4\"/>"
    }
  }
}
