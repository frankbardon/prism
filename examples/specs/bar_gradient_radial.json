{
  "$schema": "urn:prism:schema:v1:spec",
  "title": "Brand score (bar with radial gradient fill)",
  "data": {
    "name": "brand_scores",
    "values": [
      {
        "brand_id": "alpha",
        "score": 0.42
      },
      {
        "brand_id": "beta",
        "score": 0.71
      },
      {
        "brand_id": "gamma",
        "score": 0.58
      }
    ]
  },
  "mark": "bar",
  "encoding": {
