    "gradients": {
      "brand_glow": {
        "type": "radial",
        "cx": 0.5,
        "cy": 0.5,
        "radius": 0.6,
        "stops": [
          {
            "offset": 0,
            "color": "#f58518"
          },
          {
            "offset": 1,
            "color": "#4c78a8"
          }
        ]
      }
    },
    "marks": {
      "bar": {
        "fill": "url(#brand_glow)"
      }
    }
  }
